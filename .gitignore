# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Environment variables ────────────────────────────────────────────────────
.env
.env.*
!.env.example
backend/.env
frontend/.env
**/.env.local
**/.env.*.local

# ── Build output ─────────────────────────────────────────────────────────────
dist/
build/
*.tsbuildinfo

# ── Runtime / user data (never commit uploads, seeds or caches) ──────────────
backend/uploads/
backend/data/*
!backend/data/.gitignore

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Test & browser-automation artifacts ──────────────────────────────────────
test-results/
playwright-report/
.playwright/
.playwright-mcp/
*.crx
coverage/

# ── Tooling caches ───────────────────────────────────────────────────────────
.cache/
.vercel
.vite/
*.local

# ── OS / editor cruft ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.idea/
*.swp
