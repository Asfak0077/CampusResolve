# ─────────────────────────────────────────────────────────────────────────────
# CampusResolve — frontend configuration (Vite)
# Copy to frontend/.env. Values are inlined at build time — redeploy after changes.
# ─────────────────────────────────────────────────────────────────────────────

# Where the browser sends API calls.
#   - Local dev: http://localhost:5001/api  (or just /api to use the Vite proxy)
#   - Vercel:    /api
VITE_API_BASE_URL=http://localhost:5001/api

# Backend target for the dev-server proxy (/api, /socket.io, /uploads).
VITE_BACKEND_URL=http://localhost:5001

# Google Identity Services client ID (must match the origin you browse from).
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_ENABLE_GOOGLE_AUTH=false
# Optional comma-separated allow-list of origins allowed to use the Google button
VITE_GOOGLE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Supabase (enables Supabase-backed notifications); use the PUBLISHABLE key only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
