# ─────────────────────────────────────────────────────────────────────────────
# CampusResolve — backend configuration
# Copy to backend/.env and fill in. NEVER commit backend/.env.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=5001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# Database — leave MONGO_URI empty to run in offline/demo mode with the
# in-memory store (great for UI work, data resets on restart).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Auth — REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=replace_with_a_long_random_string
# JWT_SECRET is accepted as an alias for SECRET_KEY

# Google sign-in (OAuth client ID used to verify ID tokens)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Comma-separated allowlist of emails permitted to sign in with Google.
# Demo accounts are always allowed unless ALLOW_DEMO_LOGINS=false.
ALLOWED_EMAILS=
ALLOW_DEMO_LOGINS=true

# Transactional email (use a Gmail App Password, not your account password)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=
EMAIL_ADMIN=

# ── AI providers (all optional; the assistant falls back to a rule-based KB) ──
# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# NVIDIA NIM (OpenAI-compatible) — https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_CHAT_MODEL=meta/llama-3.2-11b-vision-instruct
# OpenRouter fallback — https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_EMBED_MODEL=nvidia/nemotron-3-embed-1b:free
OPENROUTER_CHAT_MODEL=minimax/minimax-m3:free

# ── Supabase (optional: notification mirroring + hosted password recovery) ────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Demo data seeding ────────────────────────────────────────────────────────
# Default: enabled outside production, disabled in production.
# SEED_DEMO_DATA=true forces it on; false disables it everywhere.
SEED_DEMO_DATA=
DEMO_PASSWORD=password123
DEMO_ADMIN_PASSWORD=password123
TEACHER_DEFAULT_PASSWORD=teach123

# ── Local development only ───────────────────────────────────────────────────
# Disables TLS certificate validation (self-signed/intercepted certs). Never on in production.
MONGO_TLS_ALLOW_INVALID_CERTS=false
